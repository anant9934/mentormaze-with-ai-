# MentorMaze Environment Variables Configuration Example

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-withered-heart-bebleio4-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-withered-heart-bebleio4.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth / Session Secrets
AUTH_SECRET="your_production_jwt_secret_must_be_at_least_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# AI Tathastu SSO & Context Gateway (OIDC)
AI_TATHASTU_SSO_URL="https://auth.aitathastu.com"
AI_TATHASTU_CLIENT_ID="mentormaze_client_id"
AI_TATHASTU_CLIENT_SECRET="mentormaze_client_secret_placeholder"
AI_TATHASTU_REDIRECT_URI="http://localhost:3000/api/auth/callback/aitathastu"

# ==============================================================================
# MULTI-PROVIDER LIVEKIT WEBRTC VIDEO INFRASTRUCTURE
# ==============================================================================
# Primary Provider (Initial 80% allocation)
LIVEKIT_PRIMARY_PROVIDER_ID="meet-primary"
LIVEKIT_PRIMARY_NAME="LiveKit Cluster Alpha (US-East)"
LIVEKIT_PRIMARY_URL="wss://meet-primary.livekit.cloud"
LIVEKIT_PRIMARY_API_KEY="API_KEY_PRIMARY"
LIVEKIT_PRIMARY_API_SECRET="API_SECRET_PRIMARY"
LIVEKIT_PRIMARY_WEIGHT="80"

# Secondary Provider (Initial 20% allocation / Failover)
LIVEKIT_SECONDARY_PROVIDER_ID="meet-secondary"
LIVEKIT_SECONDARY_NAME="LiveKit Cluster Beta (Failover)"
LIVEKIT_SECONDARY_URL="wss://meet-secondary.livekit.cloud"
LIVEKIT_SECONDARY_API_KEY="API_KEY_SECONDARY"
LIVEKIT_SECONDARY_API_SECRET="API_SECRET_SECONDARY"
LIVEKIT_SECONDARY_WEIGHT="20"

# Single-Provider Fallback (Used when only one provider is configured)
LIVEKIT_URL="wss://meet-primary.livekit.cloud"
LIVEKIT_API_KEY="API_KEY_PRIMARY"
LIVEKIT_API_SECRET="API_SECRET_PRIMARY"
NEXT_PUBLIC_LIVEKIT_URL="wss://meet-primary.livekit.cloud"

# Registering Additional Independent Standby Providers:
# Define LIVEKIT_P<N>_ID, LIVEKIT_P<N>_NAME, LIVEKIT_P<N>_URL, LIVEKIT_P<N>_KEY, LIVEKIT_P<N>_SECRET, LIVEKIT_P<N>_WEIGHT, LIVEKIT_P<N>_ENABLED
# LIVEKIT_P1_ID="meet-1"
# LIVEKIT_P1_NAME="Cluster 1"
# LIVEKIT_P1_URL="wss://meet-1.livekit.cloud"
# LIVEKIT_P1_KEY="..."
# LIVEKIT_P1_SECRET="..."
# LIVEKIT_P1_WEIGHT="80"
# LIVEKIT_P1_ENABLED="true"

# Payments (Cashfree Sandbox or Production)
CASHFREE_ENVIRONMENT="TEST"
CASHFREE_APP_ID="CF_TEST_APP_ID"
CASHFREE_SECRET_KEY="CF_TEST_SECRET_KEY"
CASHFREE_WEBHOOK_SECRET="CF_TEST_WEBHOOK_SECRET"

# Cloudflare R2 Storage (S3-Compatible)
CLOUDFLARE_R2_ACCOUNT_ID="r2_account_id_placeholder"
CLOUDFLARE_R2_ACCESS_KEY_ID="r2_access_key_placeholder"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="r2_secret_key_placeholder"
CLOUDFLARE_R2_BUCKET="mentormaze-documents"

# Resend Email (Optional in dev)
RESEND_API_KEY="re_test_key_placeholder"
EMAIL_FROM="MentorMaze <notifications@mentormaze.com>"
